{
  "name": "hubskillz-cli",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:slop": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm --filter @hubskillz/shared build && pnpm -r type-check",
    "test": "pnpm --filter @hubskillz/shared build && pnpm -r test"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.15.4"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "oxlint": "1.80.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@9.15.9"
}
